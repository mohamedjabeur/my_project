<?xml version="1.0"?>
<package format="3">
  <name>localization</name>
  <version>0.1.0</version>
  <description>Gazebo spawn, teleop drive path and ground-truth odometry TF for the ENIMIA vehicle.</description>
  <maintainer email="ahmedsalem1and1@gmail.com">Ahmed</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>vehicle_description</exec_depend>
  <exec_depend>vehicle_drivers</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
