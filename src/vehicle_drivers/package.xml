<?xml version="1.0"?>
<package format="3">
  <name>vehicle_drivers</name>
  <version>0.1.0</version>
  <description>Sensor drivers (Livox Mid-360 / RPLIDAR lidar, BNO055 IMU, OAK-D Lite / V4L2 camera) and simulation bridges for the ENIMIA vehicle.</description>
  <maintainer email="ahmedsalem1and1@gmail.com">Ahmed</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>bno055</exec_depend>
  <exec_depend>depthai_ros_driver</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
