<?xml version="1.0"?>
<package format="3">
  <name>vehicle</name>
  <version>0.1.0</version>
  <description>Drive chain of the ENIMIA car: /cmd_vel -> Ackermann command -> ESP32 (BLDC motor + steering) with a virtual ESP32 for simulation, and encoder odometry.</description>
  <maintainer email="ahmedsalem1and1@gmail.com">Ahmed</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>vehicle_description</exec_depend>
  <exec_depend>vehicle_drivers</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
